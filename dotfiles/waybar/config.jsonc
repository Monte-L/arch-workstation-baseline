{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces", "mpris"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["cpu", "memory", "network", "pulseaudio", "battery#bat1", "battery#bat2", "custom/updates", "clock"],

    "hyprland/workspaces": {
        "format": "{id}"
    },

    "hyprland/window": {
        "format": "{}"
    },

    "cpu": {
        "format": "\uf4bc {usage}%"
    },

    "memory": {
        "format": "\uf85a {used:0.1f}G"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰤭 Disconnected"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 muted"
    },

    "battery#bat1": {
        "bat": "BAT0",
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%"
    },

    "battery#bat2": {
        "bat": "BAT1",
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%"
    },

    "custom/updates": {
    "exec": "checkupdates 2>/dev/null | wc -l; exit 0",
    "interval": 3600,
    "signal": 8,
    "format": "󰚰 {}",
    "tooltip": false
    },

    "clock": {
        "format": "󰥔 {:%H:%M  %d/%m/%Y}"
    },

    "mpris": {
        "player": "spotify",
        "format": "{player_icon} {title} - {artist} [{position}/{length}]",
        "interval": 1,
        "format-paused": "⏸ {title} - {artist}",
        "player-icons": {
        "default": "▶",
            "spotify": "󰓇"
        },
        "max-length": 60,
        "tooltip": false
    }
  
}
