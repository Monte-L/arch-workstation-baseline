# Safe PATH baseline
export PATH="$HOME/.local/bin:$HOME/go/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Colors support
autoload -U colors && colors

# Optional fastfetch startup
# Replace the logo path with your own image if desired.
# fastfetch --logo ~/.config/wallpapers/terminal-logo.png --logo-type kitty --logo-width 30 --logo-height 15

# Zsh autosuggestions style
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#414868'

# Zsh syntax highlighting styles
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#9ece6a,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#7aa2f7,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#bb9af7,bold'
ZSH_HIGHLIGHT_STYLES[function]='fg=#7aa2f7'
ZSH_HIGHLIGHT_STYLES[path]='fg=#7dcfff,underline'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f7768e,bold'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#e0af68'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#e0af68'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#bb9af7'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#565f89,italic'

# Basic aliases
alias vim='nvim'
alias vi='nvim'
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Application helpers
alias spotify='hyprctl dispatch exec "nohup /opt/spotify/spotify > /dev/null 2>&1 &"'

# Waybar helper
alias waybar-restart='pkill waybar; sleep 1; hyprctl dispatch exec "waybar"'

# VPN helpers - profile name intentionally generic for public documentation
alias vpn-on='vpn-on-safe'
alias vpn-off='vpn-off-safe'
alias vpn-status='sudo wg show'

# Prompt
eval "$(starship init zsh)"

# Plugins - keep near the end
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
