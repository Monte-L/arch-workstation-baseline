* {
    bg:          rgba(26, 27, 46, 95%);
    bg-alt:      rgba(31, 35, 53, 95%);
    fg:          #c0caf5;
    fg-alt:      #565f89;
    accent:      #7aa2f7;
    urgent:      #f7768e;

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     rgba(122, 162, 247, 20%);
    border-radius:    12px;
    width:            600px;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          8px 12px;
    margin:           0 0 10px 0;
    children:         [prompt, entry];
}

prompt {
    text-color: @accent;
    padding:    0 8px 0 0;
}

entry {
    text-color: @fg;
}

listview {
    lines:   4;
    columns: 4;
    spacing: 8px;
    fixed-height: true;
}

element {
    padding:      12px 8px;
    border-radius: 8px;
    orientation: vertical;
}

element selected {
    background-color: rgba(122, 162, 247, 15%);
    text-color:       @accent;
}

element-icon {
    size:   48px;
    margin: 0 0 6px 0;
    horizontal-align: 0.5;
}

element-text {
    text-color: @fg;
    horizontal-align: 0.5;
}
